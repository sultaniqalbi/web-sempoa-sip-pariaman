{
  "name": "sempoa/sip-pariaman",
  "description": "Sempoa SIP Portal - Pariaman Branch",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-gd": "*",
    "ext-fileinfo": "*",
    "vlucas/phpdotenv": "^5.5",
    "monolog/monolog": "^3.0",
    "phpmailer/phpmailer": "^6.8",
    "league/flysystem": "^3.0",
    "respect/validation": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7",
    "symfony/var-dumper": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/App/",
      "Database\\": "database/",
      "Tests\\": "tests/"
    },
    "files": [
      "src/config/constants.php",
      "src/App/Helpers/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "php database/migrate.php",
    "seed": "php database/seed.php",
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html=./coverage",
    "lint": "phpcs src/",
    "lint:fix": "phpcbf src/",
    "analyze": "phpstan analyse src/ --level=8",
    "serve": "php -S localhost:8000 -t public/"
  },
  "config": {
    "platform": {
      "php": "8.1"
    },
    "sort-packages": true
  }
}
