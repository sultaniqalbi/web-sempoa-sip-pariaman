# Database
POSTGRES_USER=sempoa_dev
POSTGRES_PASSWORD=<GANTI_DENGAN_PASSWORD_RANDOM>
POSTGRES_DB=sempoa_sip
POSTGRES_HOST=db
POSTGRES_PORT=5432

# FastAPI
FASTAPI_ENV=development
SECRET_KEY=<GANTI_DENGAN_RANDOM_MIN_64_CHAR: python -c "import secrets; print(secrets.token_hex(64))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ESP32 Hardware
ESP32_API_KEY=<GANTI_DENGAN_RANDOM_API_KEY: python -c "import secrets; print(secrets.token_hex(32))">

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS (exact-match JSON array string)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Reset Data (opsional, jika tidak di-set hanya password owner yang diterima)
# RESET_DATA_PASSWORD=<set_jika_perlu>

# Seed Passwords (opsional, jika tidak di-set akan generate random)
# ADMIN_SEED_PASSWORD=<set_jika_perlu>
# OWNER_SEED_PASSWORD=<set_jika_perlu>

# Logging
LOG_LEVEL=INFO
